  "description": "Fast, zero-runtime-dependency HSN code lookup. Search 12,000+ codes by description or code number, validate HSN codes, and browse by chapter.",
  "main": "index.js",
  "types": "index.d.ts",
  "bin": {
    "hsn": "bin/cli.js"
  },
  "files": [
    "index.js",
