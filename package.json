    "gstin.js",
    "sac.js",
    "export.js",
    "bin/",
    "data/"
  ],
  "scripts": {
    "test": "jest --coverage",
    "build:data": "node scripts/build-data.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karthi-21/HSN-Code-Package.git"
  },
